# Node-RED Email Configuration Template
# Copy this to .env.node-red and fill in your email provider credentials
# This file contains sensitive information - DO NOT commit to version control

# ============================================================================
# Email Provider Configuration
# ============================================================================

# Gmail Configuration (Free - Recommended)
# 1. Enable 2-Factor Authentication: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password below

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_TO=recipient@gmail.com
EMAIL_FROM=your-email@gmail.com

# Alternative: Outlook/Hotmail Configuration
# SMTP_SERVER=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your-email@outlook.com
# SMTP_PASS=your-password

# Alternative: Yahoo Mail Configuration
# SMTP_SERVER=smtp.mail.yahoo.com
# SMTP_PORT=587
# SMTP_USER=your-email@yahoo.com
# SMTP_PASS=your-app-password

# ============================================================================
# Node-RED Configuration
# ============================================================================

NODE_RED_PORT=1880
NODE_ENV=production
LOG_LEVEL=info

# ============================================================================
# API Configuration
# ============================================================================

API_BASE=http://127.0.0.1:5001
API_TIMEOUT=30

# ============================================================================
# Report Scheduling (Cron Expressions)
# ============================================================================

# Daily Report - Default: 11:59 PM
# Format: second minute hour day month day-of-week
# Examples:
#   0 59 23 * * * = 11:59 PM daily
#   0 0 18 * * *  = 6:00 PM daily  
#   0 30 9 * * *  = 9:30 AM daily
DAILY_REPORT_SCHEDULE=0 59 23 * * *
DAILY_REPORT_ENABLED=true

# Weekly Report - Default: Sunday 8:00 PM
# 0 0 20 * * 0   = Sunday 8:00 PM
# 0 0 20 * * 5   = Friday 8:00 PM
# 0 0 9 * * 1    = Monday 9:00 AM
WEEKLY_REPORT_SCHEDULE=0 0 20 * * 0
WEEKLY_REPORT_ENABLED=true

# ============================================================================
# Email Settings
# ============================================================================

# Email Report Recipients
REPORT_RECIPIENTS=recipient@gmail.com,admin@example.com

# Enable/Disable Report Types
SEND_DAILY_REPORTS=true
SEND_WEEKLY_REPORTS=true
SEND_EXECUTIVE_SUMMARIES=true
SEND_DELAY_REPORTS=false
SEND_PERFORMANCE_REPORTS=false

# Email Format
EMAIL_HTML_FORMAT=true
EMAIL_INCLUDE_CHARTS=true
EMAIL_INCLUDE_TRENDS=true

# ============================================================================
# Notifications
# ============================================================================

# Send notification when report fails
NOTIFY_ON_ERROR=true
ERROR_NOTIFICATION_EMAIL=admin@example.com

# ============================================================================
# Advanced Options
# ============================================================================

# Node-RED Memory Limit (MB)
NODE_MEMORY_LIMIT=256

# Timezone for scheduling
TIMEZONE=America/Chicago

# Debug Mode (verbose logging)
DEBUG_MODE=false

# Keep database of sent reports
STORE_EMAIL_HISTORY=true
HISTORY_RETENTION_DAYS=90

