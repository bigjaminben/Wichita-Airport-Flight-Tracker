  {
    "id": "format-daily-email",
    "type": "template",
    "z": "main-flow",
    "name": "Format Daily Email HTML",
    "field": "payload",
    "fieldType": "msg",
    "format": "handlebars",
    "syntax": "handlebars",
    "template": "<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { font-family: 'Segoe UI', Arial, sans-serif; background: #f0f2f5; padding: 20px; }\n        .container { max-width: 700px; margin: 0 auto; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.1); }\n        .header { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); color: white; padding: 40px 30px; border-bottom: 4px solid #86BC25; }\n        .header h1 { font-size: 28px; margin-bottom: 10px; }\n        .header p { opacity: 0.95; font-size: 14px; }\n        .summary { background: linear-gradient(135deg, #86BC25 0%, #6b9a1f 100%); color: white; padding: 30px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }\n        .stat { text-align: center; }\n        .stat-value { font-size: 32px; font-weight: bold; }\n        .stat-label { font-size: 12px; opacity: 0.95; margin-top: 8px; text-transform: uppercase; letter-spacing: 0.5px; }\n        .content { padding: 30px; }\n        .section { margin-bottom: 30px; }\n        .section-title { font-size: 16px; font-weight: 600; color: #1a1a2e; margin-bottom: 15px; border-bottom: 2px solid #86BC25; padding-bottom: 10px; }\n        .metric-row { display: flex; justify-content: space-between; padding: 12px; background: #f9f9f9; margin-bottom: 8px; border-radius: 4px; border-left: 3px solid #86BC25; }\n        .metric-label { font-size: 13px; color: #555; }\n        .metric-value { font-size: 14px; font-weight: 600; color: #1a1a2e; }\n        .footer { background: #f9f9f9; padding: 20px 30px; text-align: center; font-size: 12px; color: #888; border-top: 1px solid #e0e0e0; }\n        .success { color: #2ecc71; }\n        .warning { color: #e74c3c; }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"header\">\n            <h1>📊 Daily Flight Report</h1>\n            <p>ICT Airport Operations - Daily Summary</p>\n        </div>\n        \n        <div class=\"summary\">\n            <div class=\"stat\">\n                <div class=\"stat-value\">{{payload.total_flights}}</div>\n                <div class=\"stat-label\">Total Flights</div>\n            </div>\n            <div class=\"stat\">\n                <div class=\"stat-value\">{{payload.arrivals}}</div>\n                <div class=\"stat-label\">Arrivals</div>\n            </div>\n            <div class=\"stat\">\n                <div class=\"stat-value\">{{payload.departures}}</div>\n                <div class=\"stat-label\">Departures</div>\n            </div>\n            <div class=\"stat\">\n                <div class=\"stat-value success\">{{payload.on_time_percentage}}%</div>\n                <div class=\"stat-label\">On-Time</div>\n            </div>\n        </div>\n        \n        <div class=\"content\">\n            <div class=\"section\">\n                <div class=\"section-title\">✈️ Flight Status Overview</div>\n                <div class=\"metric-row\">\n                    <span class=\"metric-label\">On-Time Flights:</span>\n                    <span class=\"metric-value success\">{{payload.on_time}}</span>\n                </div>\n                <div class=\"metric-row\">\n                    <span class=\"metric-label\">Delayed Flights:</span>\n                    <span class=\"metric-value warning\">{{payload.delayed}}</span>\n                </div>\n                <div class=\"metric-row\">\n                    <span class=\"metric-label\">Cancelled Flights:</span>\n                    <span class=\"metric-value warning\">{{payload.cancelled}}</span>\n                </div>\n            </div>\n            \n            <div class=\"section\">\n                <div class=\"section-title\">📈 Peak Activity</div>\n                <div class=\"metric-row\">\n                    <span class=\"metric-label\">Busiest Hour:</span>\n                    <span class=\"metric-value\">{{payload.busiest_hour}}</span>\n                </div>\n                <div class=\"metric-row\">\n                    <span class=\"metric-label\">Top Route:</span>\n                    <span class=\"metric-value\">{{payload.top_route}}</span>\n                </div>\n            </div>\n            \n            <div class=\"section\">\n                <div class=\"section-title\">⏰ Report Information</div>\n                <div class=\"metric-row\">\n                    <span class=\"metric-label\">Generated:</span>\n                    <span class=\"metric-value\">{{payload.generated_at}}</span>\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"footer\">\n            <p>This is an automated report from ICT Airport Operations Intelligence Platform</p>\n            <p>For details, visit: http://127.0.0.1:5001</p>\n        </div>\n    </div>\n</body>\n</html>",
    "x": 550,
    "y": 100,
    "wires": [["send-daily-email"]],
    "icon": "node-red/template.svg"
  },
  {
    "id": "format-weekly-email",
    "type": "template",
    "z": "main-flow",
    "name": "Format Weekly Email HTML",
    "field": "payload",
    "fieldType": "msg",
    "format": "handlebars",
    "syntax": "handlebars",
    "template": "<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { font-family: 'Segoe UI', Arial, sans-serif; background: #f0f2f5; padding: 20px; }\n        .container { max-width: 700px; margin: 0 auto; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.1); }\n        .header { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); color: white; padding: 40px 30px; border-bottom: 4px solid #86BC25; }\n        .header h1 { font-size: 28px; margin-bottom: 10px; }\n        .header p { opacity: 0.95; font-size: 14px; }\n        .summary { background: linear-gradient(135deg, #86BC25 0%, #6b9a1f 100%); color: white; padding: 30px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }\n        .stat { text-align: center; }\n        .stat-value { font-size: 32px; font-weight: bold; }\n        .stat-label { font-size: 12px; opacity: 0.95; margin-top: 8px; text-transform: uppercase; letter-spacing: 0.5px; }\n        .content { padding: 30px; }\n        .section { margin-bottom: 30px; }\n        .section-title { font-size: 16px; font-weight: 600; color: #1a1a2e; margin-bottom: 15px; border-bottom: 2px solid #86BC25; padding-bottom: 10px; }\n        .metric-row { display: flex; justify-content: space-between; padding: 12px; background: #f9f9f9; margin-bottom: 8px; border-radius: 4px; border-left: 3px solid #86BC25; }\n        .metric-label { font-size: 13px; color: #555; }\n        .metric-value { font-size: 14px; font-weight: 600; color: #1a1a2e; }\n        .trend { font-size: 13px; padding: 8px 12px; border-radius: 4px; margin-top: 4px; }\n        .trend-up { background: #d4edda; color: #155724; }\n        .trend-down { background: #f8d7da; color: #721c24; }\n        .footer { background: #f9f9f9; padding: 20px 30px; text-align: center; font-size: 12px; color: #888; border-top: 1px solid #e0e0e0; }\n        .success { color: #2ecc71; }\n        .warning { color: #e74c3c; }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"header\">\n            <h1>📊 Weekly Flight Report</h1>\n            <p>ICT Airport Operations - Weekly Executive Summary</p>\n        </div>\n        \n        <div class=\"summary\">\n            <div class=\"stat\">\n                <div class=\"stat-value\">{{payload.total_flights}}</div>\n                <div class=\"stat-label\">Weekly Flights</div>\n            </div>\n            <div class=\"stat\">\n                <div class=\"stat-value\">{{payload.avg_daily_flights}}</div>\n                <div class=\"stat-label\">Daily Avg</div>\n            </div>\n            <div class=\"stat\">\n                <div class=\"stat-value success\">{{payload.on_time_percentage}}%</div>\n                <div class=\"stat-label\">On-Time</div>\n            </div>\n            <div class=\"stat\">\n                <div class=\"stat-value warning\">{{payload.delay_percentage}}%</div>\n                <div class=\"stat-label\">Delayed</div>\n            </div>\n        </div>\n        \n        <div class=\"content\">\n            <div class=\"section\">\n                <div class=\"section-title\">📈 Weekly Statistics</div>\n                <div class=\"metric-row\">\n                    <span class=\"metric-label\">Total Flights (7-day):</span>\n                    <span class=\"metric-value\">{{payload.total_flights}}</span>\n                </div>\n                <div class=\"metric-row\">\n                    <span class=\"metric-label\">On-Time Performance:</span>\n                    <span class=\"metric-value success\">{{payload.on_time_percentage}}%</span>\n                </div>\n                <div class=\"metric-row\">\n                    <span class=\"metric-label\">Delayed Flights:</span>\n                    <span class=\"metric-value warning\">{{payload.total_delays}}</span>\n                </div>\n                <div class=\"metric-row\">\n                    <span class=\"metric-label\">Cancelled Flights:</span>\n                    <span class=\"metric-value warning\">{{payload.total_cancelled}}</span>\n                </div>\n            </div>\n            \n            <div class=\"section\">\n                <div class=\"section-title\">📊 Performance Trends</div>\n                <div class=\"metric-row\">\n                    <span class=\"metric-label\">On-Time Trend:</span>\n                    <span class=\"metric-value\">{{payload.on_time_trend}}</span>\n                </div>\n                <div style=\"margin-left: 16px; margin-top: -4px;\">\n                    <span class=\"trend {{payload.on_time_trend_class}}\">{{payload.on_time_trend}}</span>\n                </div>\n                <div class=\"metric-row\" style=\"margin-top: 12px;\">\n                    <span class=\"metric-label\">Delay Trend:</span>\n                    <span class=\"metric-value\">{{payload.delay_trend}}</span>\n                </div>\n                <div style=\"margin-left: 16px; margin-top: -4px;\">\n                    <span class=\"trend {{payload.delay_trend_class}}\">{{payload.delay_trend}}</span>\n                </div>\n            </div>\n            \n            <div class=\"section\">\n                <div class=\"section-title\">✈️ Route & Schedule Analysis</div>\n                <div class=\"metric-row\">\n                    <span class=\"metric-label\">Busiest Day:</span>\n                    <span class=\"metric-value\">{{payload.busiest_day}} ({{payload.busiest_day_count}} flights)</span>\n                </div>\n                <div class=\"metric-row\">\n                    <span class=\"metric-label\">Top Route:</span>\n                    <span class=\"metric-value\">{{payload.top_route}} ({{payload.top_route_count}} flights)</span>\n                </div>\n                <div class=\"metric-row\">\n                    <span class=\"metric-label\">Peak Hour:</span>\n                    <span class=\"metric-value\">{{payload.peak_hour}}</span>\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"footer\">\n            <p>This is an automated report from ICT Airport Operations Intelligence Platform</p>\n            <p>For detailed analysis, visit: http://127.0.0.1:5001</p>\n        </div>\n    </div>\n</body>\n</html>",
    "x": 550,
    "y": 200,
    "wires": [["send-weekly-email"]],
    "icon": "node-red/template.svg"
  },
  {
    "id": "send-daily-email",
    "type": "email",
    "z": "main-flow",
    "name": "Send Daily Email",
    "server": "{{env.SMTP_SERVER}}",
    "port": "{{env.SMTP_PORT}}",
    "secure": true,
    "tls": true,
    "auth": true,
    "userid": "{{env.SMTP_USER}}",
    "password": "{{env.SMTP_PASS}}",
    "to": "{{env.EMAIL_TO}}",
    "topic": "ICT Airport Daily Flight Report",
    "text": "Daily Flight Report",
    "x": 770,
    "y": 100,
    "wires": [["debug-daily"]],
    "icon": "node-red/envelope.svg"
  },
