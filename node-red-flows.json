[
  {
    "id": "main-flow",
    "type": "tab",
    "label": "ICT Airport Email Reports",
    "disabled": false,
    "info": "Automated email reports for flight tracking system - Daily and Weekly summaries"
  },
  {
    "id": "daily-schedule",
    "type": "cronplus",
    "z": "main-flow",
    "name": "Daily at 11:59 PM",
    "expression": "0 59 23 * * *",
    "offsetType": "utc",
    "offset": 0,
    "timeZone": "America/Chicago",
    "persist": true,
    "payload": "{\"type\": \"daily\"}",
    "payloadType": "json",
    "topic": "daily-report",
    "onceDelay": 0.1,
    "outputs": 1,
    "x": 100,
    "y": 100,
    "wires": [["fetch-daily-data"]],
    "outputLabels": []
  },
  {
    "id": "weekly-schedule",
    "type": "cronplus",
    "z": "main-flow",
    "name": "Weekly: Sunday 8:00 PM",
    "expression": "0 0 20 * * 0",
    "offsetType": "utc",
    "offset": 0,
    "timeZone": "America/Chicago",
    "persist": true,
    "payload": "{\"type\": \"weekly\"}",
    "payloadType": "json",
    "topic": "weekly-report",
    "onceDelay": 0.1,
    "outputs": 1,
    "x": 100,
    "y": 200,
    "wires": [["fetch-weekly-data"]],
    "outputLabels": []
  },
  {
    "id": "fetch-daily-data",
    "type": "http request",
    "z": "main-flow",
    "name": "Fetch Daily Report Data",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://127.0.0.1:5001/api/report/daily",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "senderr": false,
    "headers": {},
    "x": 320,
    "y": 100,
    "wires": [["format-daily-email"]],
    "icon": "node-red/rss.svg"
  },
  {
    "id": "fetch-weekly-data",
    "type": "http request",
    "z": "main-flow",
    "name": "Fetch Weekly Report Data",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://127.0.0.1:5001/api/report/weekly",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "senderr": false,
    "headers": {},
    "x": 320,
    "y": 200,
    "wires": [["format-weekly-email"]],
    "icon": "node-red/rss.svg"
